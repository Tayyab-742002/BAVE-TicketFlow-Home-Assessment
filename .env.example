# Postgres
# Host tools (alembic, local uvicorn) use localhost; docker-compose overrides
# POSTGRES_HOST/REDIS_HOST to the service names for the containerized api.
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow
POSTGRES_DB=ticketflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
ENVIRONMENT=development

# n8n at http://localhost:5678
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme123
